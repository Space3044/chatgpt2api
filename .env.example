# ============================================
# ChatGPT2API 环境变量配置示例
# ============================================

# 认证密钥（必填）
CHATGPT2API_AUTH_KEY=your_secret_key_here

# Web / API 暴露端口
CHATGPT2API_PORT=3000

# 后端同步工作线程并发容量；只要求正整数，不设置人为最高值。
# 它控制同步工作可同时占用的线程数，不等于账号、代理或上游服务的实际并发上限。
CHATGPT2API_THREAD_TOKENS=120

# Docker 镜像，可固定为 ghcr.io/yukkcat/chatgpt2api:v2.0.0
CHATGPT2API_IMAGE=ghcr.io/yukkcat/chatgpt2api:latest

# 基础 URL（可选，用于生成图片 URL）
# CHATGPT2API_BASE_URL=https://your-domain.com

# ============================================
# 语音对话（合并自 chatgpt-web-voice）
# ============================================

# 语音没有专属环境变量。语音可调项（默认音色 cove、默认语言 auto、
# 会话 TTL 180 秒、最大换号次数 4）在系统设置里的 voice 一节配置，
# 通过控制台设置页或设置接口修改。下游语音调用复用本项目的 User Key
# 鉴权；语音网关原有的 vgw_live_* 下游 Key 已彻底废弃，不再接受。

# ============================================
# 语音输入（cometix-asr sidecar）
# ============================================
#
# Studio 对话和画图输入框的按住说话按钮。音频由浏览器重采样为 16kHz
# 单声道 PCM，发给 Python 后端 /v1/asr/transcribe，再由 Go sidecar
# 做实时识别，识别结果插回输入框。sidecar 只监听容器内 loopback，
# 不对外暴露。Mock 模式没有移植。
#
# COMETIX_APP_KEY：后处理（fmt + NER）用的 app key，仓库里没有默认值，
# 必须在 VPS 的 .env 里设置。不设置时实时识别仍可用，只有独立的
# RunPostAsr 会明确报错。不要把它提交进仓库。
# COMETIX_APP_KEY=
# COMETIX_APP_ID=401734
# ASR_SIDECAR_KEY：Python 后端和 sidecar 之间的可选共享密钥（loopback
# 内部使用）。不设置时只靠 loopback 绑定隔离。
# ASR_SIDECAR_KEY=
#
# ============================================
# 应用数据库
# ============================================

# 未设置时使用 data/chatgpt2api.db
# PostgreSQL 示例
# DATABASE_URL=postgresql://user:password@localhost:5432/chatgpt2api

# 本地 PostgreSQL Compose overlay（docker-compose.postgres.yml）
# 密码仅使用字母、数字、下划线或连字符，避免连接 URI 编码不一致。
# POSTGRES_DB=chatgpt2api
# POSTGRES_USER=chatgpt2api
# POSTGRES_PASSWORD=replace_with_a_strong_password

# Supabase 示例
# DATABASE_URL=postgresql://postgres.xxx:password@aws-1-us-west-1.pooler.supabase.com:5432/postgres

# SQLite 示例
# DATABASE_URL=sqlite:////app/data/chatgpt2api.db
